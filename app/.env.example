# TradeFlow NG Backend Configuration
PORT=3001
NODE_ENV=development

# Audio Storage Provider: LocalDiskAudioStorage | SupabaseAudioStorage
AUDIO_STORAGE_PROVIDER=LocalDiskAudioStorage
AUDIO_UPLOAD_DIR=./uploads/audio

# Active Transcription Adapter: MockTranscriptionAdapter | GoogleChirpAdapter | OpenAITranscribeAdapter
TRANSCRIPTION_PROVIDER=MockTranscriptionAdapter

# LLM Provider for Extraction & Synthesis: mock | openai | anthropic
LLM_PROVIDER=mock

# Server-Only API Credentials (NEVER PASSED TO CLIENT BUNDLE)
GOOGLE_APPLICATION_CREDENTIALS=./config/google-service-account.json
GOOGLE_CLOUD_PROJECT_ID=tradeflow-ng-discovery
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
